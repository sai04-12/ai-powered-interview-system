# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI-Powered Intelligent Interview System"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=127.0.0.1
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:5000","http://localhost:5500"]

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interviewer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
# Set DB_SSL_MODE=require for cloud/Supabase PostgreSQL
DB_SSL_MODE=
DB_ECHO=False

# AI Provider Configuration
AI_PROVIDER=mock
# Options: mock, openai, anthropic, gemini
AI_API_KEY=
AI_MODEL_NAME=gpt-4o

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
